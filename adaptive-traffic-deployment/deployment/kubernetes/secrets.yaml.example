# Kubernetes Secrets Template
# Phase 4: Infrastructure Excellence
# 
# IMPORTANT: This is a template file. 
# Copy to secrets.yaml and fill in actual values.
# DO NOT commit secrets.yaml to version control.

apiVersion: v1
kind: Secret
metadata:
  name: adaptive-traffic-secrets
  namespace: default
type: Opaque
stringData:
  # Application Secrets
  SECRET_KEY: "your-secret-key-here-change-in-production"
  
  # Database Secrets
  DATABASE_URL: "postgresql://user:password@postgres-service:5432/traffic_control"
  DATABASE_POOL_SIZE: "10"
  DATABASE_MAX_OVERFLOW: "20"
  
  # Redis Secrets
  REDIS_HOST: "redis-service"
  REDIS_PORT: "6379"
  REDIS_PASSWORD: "your-redis-password"
  
  # Monitoring Secrets
  SENTRY_DSN: "https://your-sentry-dsn@sentry.io/project-id"
  
  # OAuth2 Secrets
  OAUTH2_CLIENT_ID: "your-oauth2-client-id"
  OAUTH2_CLIENT_SECRET: "your-oauth2-client-secret"
  
  # API Keys
  EXTERNAL_API_KEY: "your-external-api-key"

---
# Database Credentials
apiVersion: v1
kind: Secret
metadata:
  name: postgres-secret
  namespace: default
type: Opaque
stringData:
  POSTGRES_USER: "traffic_user"
  POSTGRES_PASSWORD: "change-this-password"
  POSTGRES_DB: "traffic_control"

---
# Redis Password
apiVersion: v1
kind: Secret
metadata:
  name: redis-secret
  namespace: default
type: Opaque
stringData:
  REDIS_PASSWORD: "change-this-password"

